<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:Pinger3.ViewModels.PageViewModels"
		xmlns:vmc="using:Pinger3.ViewModels.Controls"
		xmlns:vmd="using:Pinger3.ViewModels.Design"
		xmlns:converters="using:Pinger3.Converters"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:templatecontrols="using:Pinger3.TemplateControls"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		x:Class="Pinger3.Views.MainWindow"
		x:DataType="vm:IMainWindowViewModel"
		Icon="/Assets/avalonia-logo.ico"
		RequestedThemeVariant="Dark"
		Title="Pinger3">
	<Window.Resources>
		<ResourceDictionary>
			<converters:FractionSizeConverter x:Key="WindowSizeDivider"/>
		</ResourceDictionary>
	</Window.Resources>
	<Design.DataContext>
		<vmd:MainWindowViewModelDesign/>
	</Design.DataContext>

	<NativeMenu.Menu>
		<NativeMenu>
			<NativeMenuItem Header="Windows" IsVisible="True">
				<NativeMenu>
					<NativeMenuItem Header="PopoutWindowSettings" Click="NativeMenuItem_Click"/>
				</NativeMenu>
			</NativeMenuItem>
		</NativeMenu>
	</NativeMenu.Menu>

	<Grid RowDefinitions="*,Auto">
		<DataGrid ItemsSource="{Binding CurrentPingingTargetsGroup}">
		</DataGrid>
	</Grid>

</Window>
