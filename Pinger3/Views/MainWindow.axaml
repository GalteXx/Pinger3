<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:Pinger3.ViewModels"
		xmlns:vmd="using:Pinger3.ViewModels.Design"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:templatecontrols="using:Pinger3.TemplateControls"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		x:Class="Pinger3.Views.MainWindow"
		x:DataType="vm:IMainWindowViewModel"
		Icon="/Assets/avalonia-logo.ico"
		RequestedThemeVariant="Dark"
		Background="{DynamicResource BackgroundColor}"
		Title="Pinger3">

	<Design.DataContext>
		<vmd:MainWindowViewModelDesign/>
	</Design.DataContext>

	<StackPanel>
		<Border BorderBrush="{DynamicResource SecondaryColor}" BorderThickness="1" CornerRadius="10">
			<StackPanel Margin="15,5,15,5">
				<TextBlock Text="Active Pinging Targets"/>
				<ListBox ItemsSource="{Binding PingTargets}">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<templatecontrols:PingDisplay Classes="Full" AddressName="{Binding Name}" Ping="{Binding Ping}" ResponseWaitingTime="{Binding TimeSinceLastRequest}"/>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</StackPanel>
		</Border>
		<Border>

		</Border>
	</StackPanel>

</Window>
