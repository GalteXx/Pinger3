<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Pinger3.ViewModels.PageViewModels"
        xmlns:vmd="using:Pinger3.ViewModels.Design"
        xmlns:converters="using:Pinger3.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="450"
        x:Class="Pinger3.Views.MainWindow"
        x:DataType="vm:IMainWindowViewModel"
        Icon="/Assets/icon.png"
        x:Name="MainWindowInstance"
        Title="Pinger3">
    <Window.Resources>
        <converters:TimespanToStringConverter x:Key="TimeSpanToStringConverter" />
        <converters:TimespanToColorConverter x:Key="TimeSpanToColorConverter" />
        <converters:TimeSpanToLargestUnitConverter x:Key="TimeSpanToLargestUnitConverter" />
    </Window.Resources>
    <Design.DataContext>
        <vmd:MainWindowViewModelDesign />
    </Design.DataContext>


    <Grid RowDefinitions="25, 50 *">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10, 15" Grid.Row="1" />
        <DataGrid Margin="10" BorderBrush="{DynamicResource SecondaryColor}" BorderThickness="1"
                  GridLinesVisibility="Horizontal"
                  Background="{DynamicResource BackgroundColor}" Grid.Row="2"
                  ItemsSource="{Binding Endpoints}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" />
                <DataGridTextColumn Header="Address" Binding="{Binding Address}" />
                <DataGridTextColumn Header="Delay"
                                    Binding="{Binding DelayBetweenRequests,
                                    Converter={StaticResource TimeSpanToLargestUnitConverter}, Mode=OneWay}" />
                <DataGridTemplateColumn Header="Awaiting Response">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border CornerRadius="5" Margin="10" Width="5" Height="5"
                                        Background="{Binding TimeSinceLastRequest, Converter={StaticResource TimeSpanToColorConverter}}" />
                                <TextBlock
                                    Text="{Binding TimeSinceLastRequest, Converter={StaticResource TimeSpanToStringConverter}}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Ping">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border CornerRadius="5" Margin="10" Width="5" Height="5"
                                        Background="{Binding Ping, Converter={StaticResource TimeSpanToColorConverter}}" />
                                <TextBlock Text="{Binding Ping, Converter={StaticResource TimeSpanToStringConverter}}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Active">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox Foreground="{DynamicResource PrimaryColor}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding IsActive, Mode=TwoWay}"
                                      Command="{Binding #MainWindowInstance.DataContext.TogglePingingCommand}"
                                      CommandParameter="{Binding Id}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="PopOut">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox Foreground="{DynamicResource PrimaryColor}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding IsPopOut, Mode=TwoWay}"
                                      Command="{Binding #MainWindowInstance.DataContext.TogglePopOutCommand}"
                                      CommandParameter="{Binding Id}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Edit">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Foreground="{DynamicResource PrimaryColor}" Padding="5, 3"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Content="Edit"
                                      Command="{Binding #MainWindowInstance.DataContext.EditEndpointCommand}"
                                      BorderBrush="{DynamicResource SecondaryColor}"
                                      Background="{DynamicResource BackgroundColor}"
                                      CommandParameter="{Binding Id}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button Grid.Row="2" 
                VerticalAlignment="Bottom" HorizontalAlignment="Right" 
                Margin="20" Padding="0"
                BorderBrush="{DynamicResource SecondaryColor}" Background="{DynamicResource BackgroundColor}"
                Command="{Binding CreateNewEndpointCommand}">
            <TextBlock Text="+" FontSize="30" Margin="10, 0"/>
        </Button>
    </Grid>

</Window>