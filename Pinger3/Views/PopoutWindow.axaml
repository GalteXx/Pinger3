<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Pinger3.ViewModels.PageViewModels"
        xmlns:vmd="using:Pinger3.ViewModels.Design"
        xmlns:controls="using:Pinger3.TemplateControls"
        mc:Ignorable="d" SizeToContent="WidthAndHeight"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        Topmost="True"
        PointerPressed="OnPointerPressed"
        Icon="/Assets/icon.ico"
        ShowInTaskbar="False"
        ShowActivated="False"
        x:CompileBindings="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        x:Class="Pinger3.Views.PopoutWindow"
        Opacity="{Binding Opacity}"
        x:DataType="vm:IPopoutWindowViewModel">
    <Design.DataContext>
        <vmd:PopoutWindowViewModelDesign />
    </Design.DataContext>

    <ListBox ItemsSource="{Binding PingViewModels}" IsHitTestVisible="False">
        <ListBox.ItemTemplate>
            <DataTemplate>
                <controls:PingDisplay IsHitTestVisible="False"
                                      AddressName="{Binding Name}" Address="{Binding Address}"
                                      Ping="{Binding Ping}"
                                      ResponseWaitingTime="{Binding TimeSinceLastRequest}" />
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</Window>