<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Pinger3.TemplateControls">
    <Design.PreviewWith>
        <controls:TimeSpanPicker Value="10:11:12.004" />
    </Design.PreviewWith>
    <Style Selector="controls|TimeSpanPicker">
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Stretch">
                    <StackPanel.Styles>
                        <Style Selector="NumericUpDown">
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="TextAlignment" Value="Center" />
                            <Setter Property="Minimum" Value="0" />
                            <Setter Property="MinWidth" Value="40" />
                            <Setter Property="ShowButtonSpinner" Value="False"/>
                            <Setter Property="MinHeight" Value="20" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryColor}" />
                        </Style>
                        <Style Selector="TextBlock">
                            <Setter Property="FontSize" Value="20" />
                            <Setter Property="TextAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </StackPanel.Styles>
                    <NumericUpDown Maximum="59"
                                   Value="{TemplateBinding Hours, Mode=TwoWay,
                    Converter={x:Static controls:IntToDecimalConverter.Instance}}" />
                    <TextBlock Text=":" />
                    <NumericUpDown Maximum="59"
                                   Value="{TemplateBinding Minutes, Mode=TwoWay,
                    Converter={x:Static controls:IntToDecimalConverter.Instance}}" />
                    <TextBlock Text=":" />
                    <NumericUpDown Maximum="59"
                                   Value="{TemplateBinding Seconds, Mode=TwoWay,
                    Converter={x:Static controls:IntToDecimalConverter.Instance}}" />
                    <TextBlock Text="." />
                    <NumericUpDown Maximum="999"
                                   Value="{TemplateBinding Milliseconds, Mode=TwoWay, 
                    Converter={x:Static controls:IntToDecimalConverter.Instance}}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>