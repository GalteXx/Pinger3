<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Pinger3.TemplateControls"
        xmlns:converters="using:Pinger3.Converters">
    <Styles.Resources>
        <ResourceDictionary>
            <converters:TimespanToStringConverter x:Key="TimespanToStringConverter" />
            <converters:TimespanToColorConverter x:Key="TimespanToColorConverter" />
        </ResourceDictionary>
    </Styles.Resources>

    <Design.PreviewWith>
        <StackPanel Orientation="Vertical">
            <controls:PingDisplay AddressName="Name" Address="112" />
            <controls:PingDisplay AddressName="Name" Address="112" Classes="CompactPing"/>
            <controls:PingDisplay AddressName="Name" Address="112" Classes="ResponseTimeOnly"/>
        </StackPanel>
    </Design.PreviewWith>

    <!-- One template for all variants -->
    <Style Selector="controls|PingDisplay">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Root" CornerRadius="5" BorderThickness="1" ClipToBounds="True"
                        BorderBrush="{DynamicResource PrimaryColor}"
                        Padding="5, 0"
                        Background="{DynamicResource BackgroundColor}">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                        <TextBlock Name="PartName" Grid.Row="0"
                                   Text="{TemplateBinding AddressName}" />
                        <TextBlock Name="PartAddress" Grid.Row="1"
                                   Text="{TemplateBinding Address}" />

                        <Grid Name="PartPing" Grid.Row="2" ColumnDefinitions="12,*">
                            <Border Margin="0,2" CornerRadius="5" BorderThickness="1"
                                    BorderBrush="{DynamicResource SecondaryColor}"
                                    Background="{TemplateBinding Ping, Converter={StaticResource TimespanToColorConverter}}" />
                            <TextBlock Grid.Column="1" Margin="3, 0,0,0"
                                       Text="{TemplateBinding Ping, Converter={StaticResource TimespanToStringConverter}}" />
                        </Grid>

                        <Grid Name="PartResponse" Grid.Row="3" ColumnDefinitions="12,*">
                            <Border Margin="0,2" CornerRadius="5" BorderThickness="1"
                                    BorderBrush="{DynamicResource SecondaryColor}"
                                    Background="{TemplateBinding ResponseWaitingTime, Converter={StaticResource TimespanToColorConverter}}" />
                            <TextBlock Grid.Column="1" Margin="3, 0,0,0"
                                       Text="{TemplateBinding ResponseWaitingTime, Converter={StaticResource TimespanToStringConverter}}" />
                        </Grid>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|PingDisplay.CompactPing">
        <Style Selector="^ /template/ TextBlock#PartAddress, ^ /template/ Grid#PartResponse">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^ /template/ Border#PART_Root">
            <Setter Property="CornerRadius" Value="0" />
        </Style>
    </Style>

    <Style Selector="controls|PingDisplay.CompactResponseTime">
        <Style Selector="^ /template/ TextBlock#PartAddress, ^ /template/ Grid#PartPing">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^ /template/ Border#PART_Root">
            <Setter Property="CornerRadius" Value="0" />
        </Style>
    </Style>

    <Style Selector="controls|PingDisplay.ResponseTimeOnly">
        <Style
            Selector="^ /template/ TextBlock#PartName, ^ /template/ TextBlock#PartAddress, ^ /template/ Grid#PartPing">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^ /template/ Border#PART_Root">
            <Setter Property="CornerRadius" Value="10" />
        </Style>
    </Style>
</Styles>