<Styles xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:controls="using:Pinger3.TemplateControls"
		xmlns:converters="using:Pinger3.Converters">
	<Design.PreviewWith>
		<StackPanel Background="Black">
			<controls:PingDisplay Classes="Full" />
			<controls:PingDisplay Classes="CompactPing" />
			<controls:PingDisplay Classes="CompactAwaitngTime" />
			<controls:PingDisplay Classes="ResponeTimeOnly" />
		</StackPanel>
	</Design.PreviewWith>
	<Styles.Resources>
		<ResourceDictionary>
			<converters:TimespanToStringConverter x:Key="PingTimeConverter"/>
			<converters:TimespanToColorConverter x:Key="TimespanToStringConver"/>
		</ResourceDictionary>
	</Styles.Resources>
	<!-- Add Resources Here -->
	<Style Selector ="controls|PingDisplay.Full">
		<Setter Property="Template">
			<ControlTemplate>
				<Border>
					<Grid RowDefinitions="*, *, *, *" ColumnDefinitions="50, *"
						  Background="{DynamicResource BackgroundColor}" Margin="0, 10, 0, 0">
						<TextBlock Grid.Column="1" Text="{TemplateBinding AddressName}"/>
						<TextBlock Grid.Column="1" Grid.Row="1"
								   Text="{TemplateBinding Address}"/>
						<TextBlock Grid.Column="1" Grid.Row="2"
								   Text="{TemplateBinding Ping, Converter={StaticResource PingTimeConverter}}"
								   />
						<TextBlock Grid.Column="1" Grid.Row="3"
								   Text="{TemplateBinding ResponsWaitingTime, Converter={StaticResource PingTimeConverter}}"
								   />
						<Rectangle Fill="LightGray" Grid.Row="2" Margin="5, 2, 5, 2"/>
						<Rectangle Fill="LightGray" Grid.Row="3" Margin="5, 2, 5, 2"/>
					</Grid>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>
	<Style Selector="controls|PingDisplay.CompactPing">
		<Setter Property="Template">
			<ControlTemplate>
				<Border>
					<Grid RowDefinitions="*, *" ColumnDefinitions="50, *"
						  Background="{DynamicResource BackgroundColor}" Margin="0, 10, 0, 0">
						<TextBlock Grid.Column="1" Text="{TemplateBinding AddressName}"/>
						<Rectangle Fill="LightGray" Grid.Row="1" Margin="5, 2, 5, 2"/>
						<TextBlock Grid.Column="1" Grid.Row="1"
								   Text="{TemplateBinding Ping, Converter={StaticResource PingTimeConverter}}"/>
					</Grid>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>
	<Style Selector="controls|PingDisplay.CompactAwaitngTime">
		<Setter Property="Template">
			<ControlTemplate>
				<Border>
					<Grid RowDefinitions="*, *" ColumnDefinitions="50, *"
						  Background="{DynamicResource BackgroundColor}" Margin="0, 10, 0, 0">
						<TextBlock Grid.Column="1" Text="{TemplateBinding AddressName}"/>
						<TextBlock Grid.Column="1" Grid.Row="1"
								   Text="{TemplateBinding ResponsWaitingTime, Converter={StaticResource PingTimeConverter}}"
								   />
						<Rectangle Fill="LightGray" Grid.Row="1" Margin="5, 2, 5, 2"/>
					</Grid>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>
	<Style Selector="controls|PingDisplay.ResponeTimeOnly">
		<Setter Property="Template">
			<ControlTemplate>
				<Border>
					<StackPanel Orientation="Horizontal"
						  Background="{DynamicResource BackgroundColor}" Margin="0, 10, 0, 0">
						<Rectangle Fill="LightGray" Grid.Row="1" Margin="5, 2, 5, 2" Width ="40"/>
						<TextBlock Text="{TemplateBinding ResponsWaitingTime, Converter={StaticResource PingTimeConverter}}"
								   />
					</StackPanel>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>
</Styles>
